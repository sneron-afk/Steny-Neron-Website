---
import Layout from '../layouts/Layout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Steny Neron Photography",
  "description": "Professional headshot and portrait photography studio in Rahway, NJ.",
  "url": "https://www.stenyneron.com",
  "telephone": "+17326467002",
  "email": "info@stenyneron.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Rahway",
    "addressRegion": "NJ",
    "addressCountry": "US"
  },
  "image": "https://www.stenyneron.com/og-image.jpg",
  "sameAs": ["https://www.instagram.com/stenyneronphotography/"],
  "priceRange": "$$",
  "openingHours": "Mo-Sa 09:00-18:00"
};

const testimonials = [
  {
    quote: "Working with Steny was an absolutely pleasure! He's super creative and took the time to make sure he understood exactly what I was looking for. Extremely thorough. The energy of the shoot was amazing down to the smallest details of the 'mood music'. To say he was professional and accommodating would be an understatement. Steny truly is a CLASS ACT and would receive my highest recommendation. You will be pleased, but don't take my word for it — see for yourself!",
    name: "Aneesah",
    role: "Headshot Session",
  },
  {
    quote: "Steny took our engagement photos and did an outstanding job. He helped make us feel at ease in front of the camera, was responsive and easy to work with, and found the perfect combinations of poses and lighting. Steny does not settle for cookie cutter poses, and genuinely takes the time to get to know his subjects. I would recommend Steny Neron Photography to anybody who is lucky enough to stumble across them!",
    name: "Marc",
    role: "Engagement Session",
  },
  {
    quote: "Had a great shoot with Steny to update my headshots. He made me feel so comfortable in front of the camera and he got a lot of amazing shots. Great value for amazing photos!",
    name: "Kerri-Ann",
    role: "Headshot Session",
  },
  {
    quote: "This was my 1st time getting headshots done for professional purposes. The headshots came out amazing and the whole process was fun and comfortable. Thank you so much.",
    name: "Charon",
    role: "Professional Headshots",
  },
  {
    quote: "Look no further. One of the best photographers I have worked with. I'm big on punctuality and professionalism — he was well worth the price. I also referred many of my coworkers.",
    name: "Kelvin",
    role: "Headshot Session",
  },
  {
    quote: "What I enjoyed the most is that he already had an idea of where he wanted to shoot. Looking for location can be stressful. I look forward to working with him again!",
    name: "Elise",
    role: "Portrait Session",
  },
  {
    quote: "One of the best in the business! Booking another shoot this Fall :-)",
    name: "Aisha",
    role: "Returning Client",
  },
  {
    quote: "This was my 1st time getting headshots done for professional purposes. The headshots came out amazing and the whole process was fun and comfortable. Thank you so much.",
    name: "Andrea",
    role: "Professional Headshots",
  },
];
---

<Layout
  title="Steny Neron Photography | Headshots & Portraits | Union, Essex & Middlesex County NJ"
  description="Professional headshot and portrait photography in Rahway, NJ. Serving Union County, Essex County, and Middlesex County. Get a custom quote today."
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Hero -->
  <section class="relative h-[90vh] min-h-[560px] flex items-center justify-center overflow-hidden bg-stone-200">
    <img
      src="/images/portfolio-03.jpg"
      alt="Professional headshot by Steny Neron Photography"
      class="absolute inset-0 w-full h-full object-cover object-top"
    />
    <div class="absolute inset-0 bg-stone-900/50"></div>
    <div class="relative z-10 text-center text-white px-6 max-w-3xl mx-auto">
      <p class="text-xs uppercase tracking-[0.25em] text-gold-light mb-4">Rahway, New Jersey</p>
      <h1 class="font-serif text-5xl md:text-7xl font-semibold leading-tight mb-6">
        Your Image.<br />Elevated.
      </h1>
      <p class="text-lg md:text-xl text-white/80 max-w-xl mx-auto mb-10 font-light leading-relaxed">
        Professional headshots and portraits that make a lasting first impression. Studio sessions designed around you.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="px-8 py-4 bg-white text-stone-800 text-sm font-semibold tracking-wide hover:bg-gold-light transition-colors">Book Your Session</a>
        <a href="/portfolio/" class="px-8 py-4 border border-white text-white text-sm font-semibold tracking-wide hover:bg-white/10 transition-colors">View Portfolio</a>
      </div>
    </div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-white/50">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- About teaser -->
  <section class="max-w-6xl mx-auto px-6 py-24 grid md:grid-cols-2 gap-16 items-center">
    <div class="aspect-[4/5] overflow-hidden">
      <img src="/images/portfolio-01.jpg" alt="Portrait photography by Steny Neron" class="w-full h-full object-cover" />
    </div>
    <div>
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-4">About</p>
      <h2 class="font-serif text-4xl md:text-5xl font-semibold leading-tight mb-6 text-stone-800">More Than a Photo.<br />A Statement.</h2>
      <p class="text-stone-600 leading-relaxed mb-4">Based in Rahway, NJ, Steny Neron Photography specializes in headshots and portraits that capture who you truly are. Whether you're updating your professional profile, building your brand, or celebrating a milestone, every session is crafted with intention and care.</p>
      <p class="text-stone-600 leading-relaxed mb-8">With a studio designed for comfort and versatility, you'll have everything you need to look and feel your best — from the first frame to the final edit.</p>
      <a href="/services/" class="inline-flex items-center gap-2 text-sm font-semibold text-stone-800 border-b border-stone-800 pb-0.5 hover:text-gold hover:border-gold transition-colors">
        See Services
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <!-- Services overview -->
  <section class="bg-stone-100 py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="text-xs uppercase tracking-[0.25em] text-gold mb-3">What's Included</p>
        <h2 class="font-serif text-4xl md:text-5xl font-semibold text-stone-800">Studio Sessions</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-white p-8 border border-stone-200">
          <div class="w-10 h-10 mb-6 flex items-center justify-center bg-gold/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold mb-3 text-stone-800">Headshots</h3>
          <p class="text-stone-500 text-sm leading-relaxed">Professional headshots for LinkedIn, press kits, websites, and corporate profiles. Multiple looks, guided posing throughout.</p>
        </div>
        <div class="bg-white p-8 border border-stone-200">
          <div class="w-10 h-10 mb-6 flex items-center justify-center bg-gold/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold mb-3 text-stone-800">Portraits</h3>
          <p class="text-stone-500 text-sm leading-relaxed">Whether it's a milestone, a creative vision, branding images, or simply a photo that finally feels like you, every Steny Neron portrait session is personal, intentional, and crafted to last.</p>
        </div>
        <div class="bg-white p-8 border border-stone-200">
          <div class="w-10 h-10 mb-6 flex items-center justify-center bg-gold/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold mb-3 text-stone-800">Fine Art Prints</h3>
          <p class="text-stone-500 text-sm leading-relaxed">Premium archival prints for your office, home, or portfolio. Printed on professional-grade paper built to last.</p>
        </div>
        <div class="bg-white p-8 border border-stone-200">
          <div class="w-10 h-10 mb-6 flex items-center justify-center bg-gold/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold mb-3 text-stone-800">Maternity Portraits</h3>
          <p class="text-stone-500 text-sm leading-relaxed">Celebrate this beautiful chapter with timeless portraits in our warm, comfortable studio. Partners and family welcome.</p>
        </div>
      </div>
      <div class="text-center mt-12">
        <a href="/contact/" class="inline-block px-8 py-4 bg-stone-800 text-white text-sm font-semibold hover:bg-stone-700 transition-colors">Get a Custom Quote</a>
      </div>
    </div>
  </section>

  <!-- Corporate Headshot Days teaser -->
  <section class="max-w-6xl mx-auto px-6 py-24 grid md:grid-cols-2 gap-16 items-center">
    <div>
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-4">For Teams & Organizations</p>
      <h2 class="font-serif text-4xl md:text-5xl font-semibold leading-tight mb-6 text-stone-800">Corporate Headshot Days</h2>
      <p class="text-stone-600 leading-relaxed mb-4">Need headshots for your entire team? We offer dedicated headshot days for companies, at our Rahway studio or on-site at your office. Every employee walks away with a consistent, polished look.</p>
      <p class="text-stone-600 leading-relaxed mb-8">Ideal for law firms, financial services, real estate agencies, startups, and any organization that wants its people to look their best.</p>
      <a href="/corporate-headshots/" class="inline-flex items-center gap-2 text-sm font-semibold text-stone-800 border-b border-stone-800 pb-0.5 hover:text-gold hover:border-gold transition-colors">
        Learn About Corporate Days
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
    <div class="aspect-[4/3] overflow-hidden bg-stone-200">
      <img src="/images/portfolio-12.jpg" alt="Corporate headshot day by Steny Neron Photography" class="w-full h-full object-cover" />
    </div>
  </section>

  <!-- Portfolio preview -->
  <section class="max-w-6xl mx-auto px-6 py-24">
    <div class="text-center mb-16">
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-3">Work</p>
      <h2 class="font-serif text-4xl md:text-5xl font-semibold text-stone-800 mb-4">Recent Sessions</h2>
      <p class="text-stone-500 max-w-md mx-auto">Every session tells a story. Browse a selection of recent headshots and portraits.</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {['hero','about','portfolio-02','portfolio-04','portfolio-05','portfolio-06'].map(img => (
        <div class="aspect-[3/4] overflow-hidden bg-stone-200">
          <img src={`/images/${img}.jpg`} alt="Portrait by Steny Neron Photography" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
        </div>
      ))}
    </div>
    <div class="text-center mt-12">
      <a href="/portfolio/" class="inline-flex items-center gap-2 text-sm font-semibold text-stone-800 border-b border-stone-800 pb-0.5 hover:text-gold hover:border-gold transition-colors">
        View Full Portfolio
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <!-- Areas Served -->
  <section class="bg-stone-100 py-16 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-3">Service Area</p>
      <h2 class="font-serif text-3xl font-semibold text-stone-800 mb-4">Serving Northern & Central New Jersey</h2>
      <p class="text-stone-500 mb-10 max-w-xl mx-auto text-sm">Studio located in Rahway, NJ — conveniently accessible from Union, Essex, and Middlesex counties.</p>
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/union-county-photographer/" class="bg-white border border-stone-200 p-6 hover:border-gold transition-colors group">
          <h3 class="font-serif text-xl font-semibold text-stone-800 mb-2 group-hover:text-gold transition-colors">Union County</h3>
          <p class="text-stone-500 text-sm">Westfield · Summit · Cranford · Elizabeth · Rahway · Scotch Plains</p>
        </a>
        <a href="/essex-county-photographer/" class="bg-white border border-stone-200 p-6 hover:border-gold transition-colors group">
          <h3 class="font-serif text-xl font-semibold text-stone-800 mb-2 group-hover:text-gold transition-colors">Essex County</h3>
          <p class="text-stone-500 text-sm">Newark · Montclair · Maplewood · Livingston · West Orange · Millburn</p>
        </a>
        <a href="/middlesex-county-photographer/" class="bg-white border border-stone-200 p-6 hover:border-gold transition-colors group">
          <h3 class="font-serif text-xl font-semibold text-stone-800 mb-2 group-hover:text-gold transition-colors">Middlesex County</h3>
          <p class="text-stone-500 text-sm">Edison · Woodbridge · Piscataway · New Brunswick · Metuchen · Old Bridge</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-stone-800 py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="text-xs uppercase tracking-[0.25em] text-gold mb-3">Client Love</p>
        <h2 class="font-serif text-4xl md:text-5xl font-semibold text-white mb-4">What Clients Say</h2>
        <div class="flex items-center justify-center gap-2">
          <div class="flex gap-1">
            {[1,2,3,4,5].map(() => (
              <svg class="h-5 w-5 text-gold" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <span class="text-white font-semibold">5.0</span>
          <a href="https://share.google/C36GFCW9IQk9PF4w3" target="_blank" rel="noopener noreferrer" class="text-stone-400 text-sm hover:text-white transition-colors underline underline-offset-2">See all reviews on Google</a>
        </div>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {testimonials.slice(0, 3).map(t => (
          <div class="bg-stone-700/50 p-8 border border-stone-600">
            <svg class="h-8 w-8 text-gold mb-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
            <p class="text-stone-300 leading-relaxed mb-6 italic">"{t.quote}"</p>
            <div>
              <p class="font-semibold text-white text-sm">{t.name}</p>
              <p class="text-stone-400 text-xs mt-0.5">{t.role}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="https://share.google/C36GFCW9IQk9PF4w3" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-3 border border-stone-500 text-stone-300 text-sm font-medium hover:bg-stone-700 transition-colors">
          Read All 8 Reviews on Google
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-24 px-6 text-center">
    <div class="max-w-2xl mx-auto">
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-4">Ready?</p>
      <h2 class="font-serif text-4xl md:text-5xl font-semibold text-stone-800 mb-6">Let's Create Something Beautiful</h2>
      <p class="text-stone-500 leading-relaxed mb-10">Your session is just a message away. Reach out to check availability and reserve your spot at our Rahway, NJ studio.</p>
      <a href="/contact/" class="inline-block px-10 py-4 bg-stone-800 text-white text-sm font-semibold tracking-wide hover:bg-stone-700 transition-colors">Book Your Session</a>
    </div>
  </section>
</Layout>