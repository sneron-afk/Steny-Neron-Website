---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Book a Session | Steny Neron Photography | Rahway, NJ"
  description="Book a headshot or portrait session with Steny Neron Photography in Rahway, NJ. Contact us at 732.423.1900 or info@stenyneron.com."
>
  <!-- Page header -->
  <section class="bg-stone-100 py-20 px-6 text-center">
    <p class="text-xs uppercase tracking-[0.25em] text-gold mb-3">Get in Touch</p>
    <h1 class="font-serif text-5xl md:text-6xl font-semibold text-stone-800 mb-4">Book Your Session</h1>
    <p class="text-stone-500 max-w-xl mx-auto text-lg font-light">
      Ready to invest in images that open doors? Fill out the form below and we'll be in touch within 1–2 business days.
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-24 grid md:grid-cols-5 gap-16">
    <!-- Contact info sidebar -->
    <div class="md:col-span-2 space-y-10">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-gold mb-4">Studio</p>
        <p class="font-serif text-xl font-semibold text-stone-800 mb-1">Steny Neron Photography</p>
        <p class="text-stone-500 text-sm">Rahway, NJ</p>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-gold mb-4">Phone</p>
        <a href="tel:7324231900" class="text-stone-700 font-medium hover:text-gold transition-colors">
          732.423.1900
        </a>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-gold mb-4">Email</p>
        <a href="mailto:info@stenyneron.com" class="text-stone-700 font-medium hover:text-gold transition-colors break-all">
          info@stenyneron.com
        </a>
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-gold mb-4">Instagram</p>
        <a
          href="https://www.instagram.com/stenyneronphotography/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-stone-700 font-medium hover:text-gold transition-colors text-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          @stenyneronphotography
        </a>
      </div>

      <div class="bg-stone-100 p-6 border-l-2 border-gold">
        <p class="text-sm text-stone-600 leading-relaxed">
          <span class="font-semibold text-stone-800">Session fee:</span> $350<br />
          <span class="font-semibold text-stone-800">Images:</span> $50 each<br />
          <span class="font-semibold text-stone-800">Prints (8×10):</span> $75 each
        </p>
        <a href="/services/" class="mt-4 inline-block text-xs font-semibold text-gold-dark underline underline-offset-2">
          Full pricing details →
        </a>
      </div>
    </div>

    <!-- Contact form -->
    <div class="md:col-span-3">
      <form
        name="booking"
        method="POST"
        action="/success/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-6"
      >
        <input type="hidden" name="form-name" value="booking" />
        <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-xs uppercase tracking-[0.15em] text-stone-500 mb-2">Full Name *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full border border-stone-300 px-4 py-3 text-sm text-stone-800 bg-white focus:outline-none focus:border-stone-600 transition-colors placeholder:text-stone-400"
              placeholder="Your name"
            />
          </div>
          <div>
            <label for="email" class="block text-xs uppercase tracking-[0.15em] text-stone-500 mb-2">Email Address *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full border border-stone-300 px-4 py-3 text-sm text-stone-800 bg-white focus:outline-none focus:border-stone-600 transition-colors placeholder:text-stone-400"
              placeholder="your@email.com"
            />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="phone" class="block text-xs uppercase tracking-[0.15em] text-stone-500 mb-2">Phone Number</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full border border-stone-300 px-4 py-3 text-sm text-stone-800 bg-white focus:outline-none focus:border-stone-600 transition-colors placeholder:text-stone-400"
              placeholder="(xxx) xxx-xxxx"
            />
          </div>
          <div>
            <label for="date" class="block text-xs uppercase tracking-[0.15em] text-stone-500 mb-2">Preferred Date</label>
            <input
              type="date"
              id="date"
              name="preferred_date"
              class="w-full border border-stone-300 px-4 py-3 text-sm text-stone-800 bg-white focus:outline-none focus:border-stone-600 transition-colors"
            />
          </div>
        </div>

        <div>
          <label for="session_type" class="block text-xs uppercase tracking-[0.15em] text-stone-500 mb-2">Session Type</label>
          <select
            id="session_type"
            name="session_type"
            class="w-full border border-stone-300 px-4 py-3 text-sm text-stone-800 bg-white focus:outline-none focus:border-stone-600 transition-colors"
          >
            <option value="">Select a session type</option>
            <option value="headshots">Professional Headshots</option>
            <option value="portraits">Personal Portraits</option>
            <option value="both">Both</option>
            <option value="unsure">Not sure yet</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-xs uppercase tracking-[0.15em] text-stone-500 mb-2">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            class="w-full border border-stone-300 px-4 py-3 text-sm text-stone-800 bg-white focus:outline-none focus:border-stone-600 transition-colors placeholder:text-stone-400 resize-none"
            placeholder="Tell me a bit about what you're looking for, or ask any questions you have..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-4 bg-stone-800 text-white text-sm font-semibold tracking-wide hover:bg-stone-700 transition-colors"
        >
          Send Message & Request Booking
        </button>

        <p class="text-xs text-stone-400 text-center">
          We respond within 1–2 business days. Prefer to call? Reach us at
          <a href="tel:7324231900" class="underline hover:text-stone-600">732.423.1900</a>.
        </p>
      </form>
    </div>
  </section>
</Layout>
