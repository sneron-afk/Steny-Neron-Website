---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Message Sent | Steny Neron Photography"
  description="Thank you for reaching out to Steny Neron Photography. We'll be in touch within 1–2 business days."
>
  <section class="min-h-[70vh] flex items-center justify-center px-6 text-center">
    <div class="max-w-lg">
      <div class="w-16 h-16 mx-auto mb-8 flex items-center justify-center border-2 border-gold">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-4">Message Received</p>
      <h1 class="font-serif text-4xl font-semibold text-stone-800 mb-4">Thank You!</h1>
      <p class="text-stone-500 leading-relaxed mb-8">
        Your booking request has been sent. We'll be in touch within 1–2 business days to confirm your session details.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="px-8 py-3 bg-stone-800 text-white text-sm font-semibold hover:bg-stone-700 transition-colors">
          Back to Home
        </a>
        <a href="/portfolio/" class="px-8 py-3 border border-stone-300 text-stone-700 text-sm font-semibold hover:border-stone-600 transition-colors">
          View Portfolio
        </a>
      </div>
    </div>
  </section>
</Layout>
