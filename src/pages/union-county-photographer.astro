---
import Layout from '../layouts/Layout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Steny Neron Photography",
  "description": "Professional headshot and portrait photographer serving Union County, NJ including Westfield, Summit, Cranford, Elizabeth, and Rahway.",
  "url": "https://www.stenyneron.com/union-county-photographer",
  "telephone": "+17324231900",
  "email": "info@stenyneron.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Rahway",
    "addressRegion": "NJ",
    "addressCountry": "US"
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": "Union County, NJ"
  },
  "sameAs": ["https://www.instagram.com/stenyneronphotography/"]
};

const cities = [
  "Rahway", "Westfield", "Summit", "Cranford", "Elizabeth",
  "Union", "Linden", "Plainfield", "Scotch Plains", "Clark",
  "Fanwood", "Springfield", "Roselle", "Kenilworth", "Mountainside"
];
---

<Layout
  title="Union County Photographer | Headshots & Portraits | Steny Neron Photography"
  description="Professional headshot and portrait photographer serving Union County, NJ. Studio sessions from $350. Serving Westfield, Summit, Cranford, Elizabeth, Rahway and all of Union County."
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Hero -->
  <section class="bg-stone-800 py-24 px-6 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-4">Serving Union County, NJ</p>
      <h1 class="font-serif text-5xl md:text-6xl font-semibold text-white leading-tight mb-6">
        Union County<br />Headshot Photographer
      </h1>
      <p class="text-stone-300 text-lg leading-relaxed mb-10 max-w-2xl mx-auto">
        Professional headshots and portraits for executives, entrepreneurs, and creatives across Union County, NJ. Studio located in Rahway — minutes from Westfield, Summit, Cranford, and Elizabeth.
      </p>
      <a href="/contact/" class="inline-block px-10 py-4 bg-white text-stone-800 text-sm font-semibold hover:bg-gold-light transition-colors">
        Book Your Session
      </a>
    </div>
  </section>

  <!-- About section -->
  <section class="max-w-4xl mx-auto px-6 py-24 grid md:grid-cols-2 gap-16 items-center">
    <div class="aspect-[3/4] overflow-hidden bg-stone-200">
      <img src="/images/portfolio-01.jpg" alt="Union County headshot photographer" class="w-full h-full object-cover" />
    </div>
    <div>
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-4">Why Choose Steny Neron</p>
      <h2 class="font-serif text-4xl font-semibold text-stone-800 mb-6 leading-tight">
        Union County's Premier Portrait Studio
      </h2>
      <p class="text-stone-600 leading-relaxed mb-4">
        Whether you're a professional in Westfield updating your LinkedIn profile, an entrepreneur in Summit building your personal brand, or a job seeker in Elizabeth ready to make a strong first impression — great headshots open doors.
      </p>
      <p class="text-stone-600 leading-relaxed mb-8">
        Our Rahway studio is centrally located in Union County, making it easy to reach from anywhere in the area. Sessions include up to 4 hours, unlimited outfit changes, and professional retouching.
      </p>
      <a href="/services/" class="inline-flex items-center gap-2 text-sm font-semibold text-stone-800 border-b border-stone-800 pb-0.5 hover:text-gold hover:border-gold transition-colors">
        View Pricing & Services
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Services -->
  <section class="bg-stone-100 py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-3">Sessions & Pricing</p>
      <h2 class="font-serif text-4xl font-semibold text-stone-800 mb-12">What's Included</h2>
      <div class="grid md:grid-cols-3 gap-6 text-left">
        {[
          { title: "Studio Session Fee", price: "$350", desc: "Up to 4 hours, unlimited looks, choice of backgrounds." },
          { title: "Digital Images", price: "$50/image", desc: "Professionally retouched, high-resolution digital files." },
          { title: "Fine Art Prints", price: "$75/print", desc: "Premium 8×10 prints for your office or home." },
        ].map(s => (
          <div class="bg-white p-8 border border-stone-200">
            <h3 class="font-serif text-xl font-semibold text-stone-800 mb-2">{s.title}</h3>
            <p class="font-serif text-3xl font-bold text-stone-800 mb-3">{s.price}</p>
            <p class="text-stone-500 text-sm">{s.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-10">
        <a href="/contact/" class="inline-block px-10 py-4 bg-stone-800 text-white text-sm font-semibold hover:bg-stone-700 transition-colors">
          Book Your Union County Session
        </a>
      </div>
    </div>
  </section>

  <!-- Cities served -->
  <section class="max-w-4xl mx-auto px-6 py-20">
    <div class="text-center mb-10">
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-3">Service Area</p>
      <h2 class="font-serif text-4xl font-semibold text-stone-800 mb-4">Serving All of Union County</h2>
      <p class="text-stone-500 max-w-lg mx-auto">Conveniently located in Rahway, NJ — easy to reach from every corner of Union County.</p>
    </div>
    <div class="flex flex-wrap gap-3 justify-center">
      {cities.map(city => (
        <span class="px-4 py-2 bg-stone-100 border border-stone-200 text-stone-600 text-sm">
          {city}, NJ
        </span>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-stone-800 py-20 px-6 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-serif text-4xl font-semibold text-white mb-4">Ready to Elevate Your Image?</h2>
      <p class="text-stone-400 mb-8">Union County's top headshot photographer is ready for you. Studio sessions start at $350.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="px-8 py-4 bg-white text-stone-800 text-sm font-semibold hover:bg-gold-light transition-colors">Book a Session</a>
        <a href="tel:7324231900" class="px-8 py-4 border border-white text-white text-sm font-semibold hover:bg-white/10 transition-colors">Call 732.423.1900</a>
      </div>
    </div>
  </section>
</Layout>
