---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: "How long is a typical session?",
    a: "Studio sessions include up to 4 hours of shooting time. This gives you plenty of time for multiple looks, outfit changes, and background selections without feeling rushed."
  },
  {
    q: "How many outfits can I bring?",
    a: "As many as you like! We want you to have options. Most clients bring 3–5 outfits to maximize variety in their final gallery."
  },
  {
    q: "When will I receive my images?",
    a: "You'll receive a proof gallery within 5–7 business days of your session. Once you've made your selections, retouched files are delivered within an additional 5 business days."
  },
  {
    q: "Do I need to have experience in front of a camera?",
    a: "Not at all. Most clients have never had a professional session before. It's Steny's job to guide you — from posing to expression — so you feel natural and confident throughout."
  },
];
---

<Layout
  title="Services & Pricing | Steny Neron Photography | Rahway, NJ"
  description="Headshot and portrait session pricing in Rahway, NJ. Studio session fee $350. Retouched digital images $50 each. 8x10 prints $75."
>
  <!-- Page header -->
  <section class="bg-stone-100 py-20 px-6 text-center">
    <p class="text-xs uppercase tracking-[0.25em] text-gold mb-3">Invest in Yourself</p>
    <h1 class="font-serif text-5xl md:text-6xl font-semibold text-stone-800 mb-4">Services & Pricing</h1>
    <p class="text-stone-500 max-w-xl mx-auto text-lg font-light">
      Transparent pricing, no surprises. Every session is designed to help you look and feel your absolute best.
    </p>
  </section>

  <!-- Main pricing -->
  <section class="max-w-4xl mx-auto px-6 py-24">
    <div class="border border-stone-200 bg-white">
      <!-- Session fee -->
      <div class="p-10 border-b border-stone-200">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
          <div class="flex-1">
            <p class="text-xs uppercase tracking-[0.2em] text-gold mb-2">Studio Session</p>
            <h2 class="font-serif text-3xl font-semibold text-stone-800 mb-4">Headshots & Portraits</h2>
            <p class="text-stone-500 leading-relaxed mb-6">
              A dedicated, unhurried studio session at our Rahway, NJ location. You'll have full access to our equipment, lighting setups, and background options.
            </p>
            <ul class="space-y-3">
              {[
                "Up to 4 hours of shooting time",
                "Unlimited looks & outfit changes",
                "Choice of backgrounds",
                "Professional lighting & studio setup",
                "Guided posing & direction throughout",
                "Online proof gallery within 5–7 business days",
              ].map(item => (
                <li class="flex items-start gap-3 text-sm text-stone-600">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="md:text-right">
            <p class="font-serif text-5xl font-bold text-stone-800">$350</p>
            <p class="text-stone-400 text-sm mt-1">session fee</p>
          </div>
        </div>
      </div>

      <!-- Add-ons -->
      <div class="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-stone-200">
        <div class="p-10">
          <p class="text-xs uppercase tracking-[0.2em] text-gold mb-2">Add-On</p>
          <h3 class="font-serif text-2xl font-semibold text-stone-800 mb-2">Digital Images</h3>
          <p class="font-serif text-4xl font-bold text-stone-800 mb-4">$50 <span class="text-base font-sans font-normal text-stone-500">/ image</span></p>
          <p class="text-stone-500 text-sm leading-relaxed">
            Professionally retouched, high-resolution digital files. Perfect for LinkedIn, websites, press kits, and social media. Delivered via online gallery download.
          </p>
        </div>
        <div class="p-10">
          <p class="text-xs uppercase tracking-[0.2em] text-gold mb-2">Add-On</p>
          <h3 class="font-serif text-2xl font-semibold text-stone-800 mb-2">Fine Art Prints</h3>
          <p class="font-serif text-4xl font-bold text-stone-800 mb-4">$75 <span class="text-base font-sans font-normal text-stone-500">/ print (8×10)</span></p>
          <p class="text-stone-500 text-sm leading-relaxed">
            Premium quality 8×10 fine art prints. Ideal for your office, home wall, or as a personal keepsake. Printed on professional archival paper.
          </p>
        </div>
      </div>
    </div>

    <!-- Maternity portraits -->
    <div class="border border-stone-200 bg-white mt-8">
      <div class="p-10">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
          <div class="flex-1">
            <p class="text-xs uppercase tracking-[0.2em] text-gold mb-2">Studio Session</p>
            <h2 class="font-serif text-3xl font-semibold text-stone-800 mb-4">Maternity Portraits</h2>
            <p class="text-stone-500 leading-relaxed mb-6">
              Celebrate the beauty of this chapter with a dedicated maternity session in our Rahway, NJ studio. Every detail is designed to make you feel comfortable, radiant, and truly seen.
            </p>
            <ul class="space-y-3">
              {[
                "Up to 4 hours of shooting time",
                "Multiple looks & wardrobe changes",
                "Variety of backgrounds & lighting setups",
                "Guided posing tailored to your comfort",
                "Partner & family welcome",
                "Online proof gallery within 5–7 business days",
              ].map(item => (
                <li class="flex items-start gap-3 text-sm text-stone-600">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="md:text-right">
            <p class="font-serif text-5xl font-bold text-stone-800">$350</p>
            <p class="text-stone-400 text-sm mt-1">session fee</p>
            <p class="text-stone-400 text-xs mt-2">+ $50/image · $75/print</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Example investment note -->
    <div class="mt-8 bg-gold-light/40 border border-gold/30 p-6">
      <p class="text-sm text-stone-700 leading-relaxed">
        <span class="font-semibold">Example investment:</span> A studio session + 3 retouched digital images + 1 print comes to <strong>$575</strong>. Not sure how many images you'll want? Most clients select 3–5 after viewing their proof gallery.
      </p>
    </div>

    <div class="text-center mt-12">
      <a href="/contact/" class="inline-block px-10 py-4 bg-stone-800 text-white text-sm font-semibold hover:bg-stone-700 transition-colors">
        Book Your Session
      </a>
      <p class="mt-6 text-sm text-stone-500">
        Looking for something different? <a href="/contact/" class="text-stone-700 font-medium underline underline-offset-2 hover:text-gold transition-colors">Contact us</a> to discuss a session tailored to your needs.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-stone-100 py-24 px-6">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-xs uppercase tracking-[0.25em] text-gold mb-3">Questions</p>
        <h2 class="font-serif text-4xl font-semibold text-stone-800">Frequently Asked</h2>
      </div>
      <div class="space-y-6">
        {faqs.map(faq => (
          <details class="bg-white border border-stone-200 group">
            <summary class="flex items-center justify-between px-8 py-5 cursor-pointer list-none font-medium text-stone-800 hover:text-gold transition-colors">
              {faq.q}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-stone-400 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <p class="px-8 pb-6 text-stone-500 text-sm leading-relaxed border-t border-stone-100 pt-4">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
