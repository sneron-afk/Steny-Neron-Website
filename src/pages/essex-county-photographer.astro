---
import Layout from '../layouts/Layout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Steny Neron Photography",
  "description": "Professional headshot and portrait photographer serving Essex County, NJ including Newark, Montclair, Maplewood, Livingston, and West Orange.",
  "url": "https://www.stenyneron.com/essex-county-photographer",
  "telephone": "+17326467002",
  "email": "info@stenyneron.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Rahway",
    "addressRegion": "NJ",
    "addressCountry": "US"
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": "Essex County, NJ"
  },
  "sameAs": ["https://www.instagram.com/stenyneronphotography/"]
};

const cities = [
  "Newark", "Montclair", "Maplewood", "South Orange", "Livingston",
  "West Orange", "Bloomfield", "East Orange", "Irvington", "Millburn",
  "Nutley", "Belleville", "Glen Ridge", "Caldwell", "Verona"
];
---

<Layout
  title="Essex County Photographer | Headshots & Portraits | Steny Neron Photography"
  description="Professional headshot and portrait photographer serving Essex County, NJ. Studio sessions from $350. Serving Newark, Montclair, Maplewood, Livingston, West Orange and all of Essex County."
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="bg-stone-800 py-24 px-6 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-4">Serving Essex County, NJ</p>
      <h1 class="font-serif text-5xl md:text-6xl font-semibold text-white leading-tight mb-6">Essex County<br />Headshot Photographer</h1>
      <p class="text-stone-300 text-lg leading-relaxed mb-10 max-w-2xl mx-auto">Serving professionals, entrepreneurs, and creatives across Essex County, NJ. From Newark to Montclair to Livingston — our Rahway studio is just a short drive away.</p>
      <a href="/contact/" class="inline-block px-10 py-4 bg-white text-stone-800 text-sm font-semibold hover:bg-gold-light transition-colors">Book Your Session</a>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-24 grid md:grid-cols-2 gap-16 items-center">
    <div class="aspect-[3/4] overflow-hidden bg-stone-200">
      <img src="/images/portfolio-02.jpg" alt="Essex County headshot photographer" class="w-full h-full object-cover" />
    </div>
    <div>
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-4">Why Choose Steny Neron</p>
      <h2 class="font-serif text-4xl font-semibold text-stone-800 mb-6 leading-tight">Essex County's Go-To Portrait Studio</h2>
      <p class="text-stone-600 leading-relaxed mb-4">Essex County is home to some of New Jersey's most driven professionals — from Newark's legal and finance sectors to Montclair's creative community to Livingston's thriving business scene. Your headshot should match your ambition.</p>
      <p class="text-stone-600 leading-relaxed mb-8">Our Rahway studio is quick and easy to reach from anywhere in Essex County. We offer a relaxed, unhurried environment where great images happen naturally.</p>
      <a href="/services/" class="inline-flex items-center gap-2 text-sm font-semibold text-stone-800 border-b border-stone-800 pb-0.5 hover:text-gold hover:border-gold transition-colors">
        View Pricing & Services
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <section class="bg-stone-100 py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-3">Sessions & Pricing</p>
      <h2 class="font-serif text-4xl font-semibold text-stone-800 mb-12">What's Included</h2>
      <div class="grid md:grid-cols-3 gap-6 text-left">
        {[
          { title: "Studio Session Fee", price: "$350", desc: "Up to 4 hours, unlimited looks, choice of backgrounds." },
          { title: "Digital Images", price: "$50/image", desc: "Professionally retouched, high-resolution digital files." },
          { title: "Fine Art Prints", price: "$75/print", desc: "Premium 8×10 prints for your office or home." },
        ].map(s => (
          <div class="bg-white p-8 border border-stone-200">
            <h3 class="font-serif text-xl font-semibold text-stone-800 mb-2">{s.title}</h3>
            <p class="font-serif text-3xl font-bold text-stone-800 mb-3">{s.price}</p>
            <p class="text-stone-500 text-sm">{s.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-10">
        <a href="/contact/" class="inline-block px-10 py-4 bg-stone-800 text-white text-sm font-semibold hover:bg-stone-700 transition-colors">Book Your Essex County Session</a>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-20">
    <div class="text-center mb-10">
      <p class="text-xs uppercase tracking-[0.25em] text-gold mb-3">Service Area</p>
      <h2 class="font-serif text-4xl font-semibold text-stone-800 mb-4">Serving All of Essex County</h2>
      <p class="text-stone-500 max-w-lg mx-auto">Studio located in Rahway, NJ — easily accessible from every part of Essex County.</p>
    </div>
    <div class="flex flex-wrap gap-3 justify-center">
      {cities.map(city => (
        <span class="px-4 py-2 bg-stone-100 border border-stone-200 text-stone-600 text-sm">{city}, NJ</span>
      ))}
    </div>
  </section>

  <section class="bg-stone-800 py-20 px-6 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-serif text-4xl font-semibold text-white mb-4">Ready to Elevate Your Image?</h2>
      <p class="text-stone-400 mb-8">Serving Essex County professionals with studio headshots starting at $350.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="px-8 py-4 bg-white text-stone-800 text-sm font-semibold hover:bg-gold-light transition-colors">Book a Session</a>
        <a href="tel:7326467002" class="px-8 py-4 border border-white text-white text-sm font-semibold hover:bg-white/10 transition-colors">Call 732.646.7002</a>
      </div>
    </div>
  </section>
</Layout>
